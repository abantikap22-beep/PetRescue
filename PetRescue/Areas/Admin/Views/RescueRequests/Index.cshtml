@model IEnumerable<PetRescue.Models.RescueRequest>

@{
    ViewData["Title"] = "Manage Rescue Requests";
}

<br />
<br />

<div class="row">
    <div class="col-md-6">
        <h2 class="text-info">Rescue Request List</h2>
    </div>
</div>

<br />

<div>
    <table id="myTable" class="table table-striped table-bordered">

        <thead>
            <tr class="table-info">
                <th>Request ID</th>
                <th>Reporter Name</th>
                <th>Contact Number</th>
                <th>Pet Type</th>
                <th>Description</th>
                <th>Location</th>
                <th>Status</th>
                <th>Image</th>
                <th>Created At</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.RescueRequestId</td>
                    <td>@item.ReporterName</td>
                    <td>@item.ContactNumber</td>
                    <td>@item.PetType?.PetTypeName</td>
                    <td>@item.Description</td>
                    <td>@item.Location</td>
                    <td>
                        @if (item.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">
                                @item.Status
                            </span>
                        }
                        else if (item.Status == "Approved")
                        {
                            <span class="badge bg-success">
                                @item.Status
                            </span>
                        }
                        else if (item.Status == "Rejected")
                        {
                            <span class="badge bg-danger">
                                @item.Status
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">
                                @item.Status
                            </span>
                        }
                    </td>

                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="~/@item.ImageUrl"
                                 width="70"
                                 height="60"
                                 style="object-fit:cover;" />
                        }
                    </td>

                    <td>
                        @item.CreatedAt.ToString("dd-MM-yyyy")
                    </td>

                    <td>
                        <a asp-action="Details"
                           asp-route-id="@item.RescueRequestId"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.RescueRequestId"
                           class="btn btn-success btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.RescueRequestId"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>

@section Scripts {

    

    <script src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#myTable').DataTable({
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ]
            });
        });
        $(function () {

            var save = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(TempData["save"])
                    );

        if (save) {
            alertify.success(save);
        }

        });

    </script>
}
