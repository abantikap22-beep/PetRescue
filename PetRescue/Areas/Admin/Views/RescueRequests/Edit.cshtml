@model PetRescue.Models.RescueRequest

@{
    ViewData["Title"] = "Edit Rescue Request";
}

<br />

<h2 class="text-info">Edit Rescue Request</h2>

<form asp-action="Edit"
      asp-controller="RescueRequests"
      asp-area="Admin"
      asp-route-id="@Model.RescueRequestId"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="RescueRequestId" />

    <div class="p-4 rounded border">

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="row">

            <div class="col-md-8">

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label asp-for="ReporterName"></label>
                    </div>

                    <div class="col-md-8">
                        <input asp-for="ReporterName"
                               class="form-control" />

                        <span asp-validation-for="ReporterName"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label asp-for="ContactNumber"></label>
                    </div>

                    <div class="col-md-8">
                        <input asp-for="ContactNumber"
                               class="form-control" />

                        <span asp-validation-for="ContactNumber"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label asp-for="PetTypeId">Pet Type</label>
                    </div>

                    <div class="col-md-8">
                        <select asp-for="PetTypeId"
                                asp-items="ViewBag.PetTypeId"
                                class="form-control">
                            <option value="">Select Pet Type</option>
                        </select>

                        <span asp-validation-for="PetTypeId"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label asp-for="Description"></label>
                    </div>

                    <div class="col-md-8">
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="3"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label asp-for="Location"></label>
                    </div>

                    <div class="col-md-8">
                        <input asp-for="Location"
                               class="form-control" />

                        <span asp-validation-for="Location"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label asp-for="Status"></label>
                    </div>

                    <div class="col-md-8">
                        <select asp-for="Status"
                                class="form-control">
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                            <option value="Completed">Completed</option>
                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label>Image</label>
                    </div>

                    <div class="col-md-8">
                        <input type="file"
                               name="image"
                               class="form-control"
                               accept="image/*" />
                    </div>
                </div>

                <div class="form-group">
                    <button type="submit"
                            class="btn btn-primary">
                        Update
                    </button>

                    <a asp-action="Index"
                       asp-controller="RescueRequests"
                       asp-area="Admin"
                       class="btn btn-success">
                        Back to List
                    </a>
                </div>

            </div>

            <div class="col-md-4 text-center">

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Url.Content("~/" + Model.ImageUrl)"
                         class="img-fluid"
                         style="max-width:250px; max-height:250px; object-fit:contain;"
                         alt="Rescue Request Image" />
                }
                else
                {
                    <p class="text-muted">
                        No image available
                    </p>
                }

            </div>

        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
