@model PetRescue.Models.PetType

@{
    ViewData["Title"] = "Details";
}

<br />

<h2 class="text-info">Pet Type Details</h2>

<form asp-action="Details" method="get">
    <div class="p-4 rounded border">

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <div class="form-group row mb-3">
            <div class="col-md-2">
                <label asp-for="PetTypeName"></label>
            </div>

            <div class="col-md-5">
                <input asp-for="PetTypeName"
                       readonly="readonly"
                       class="form-control" />

                <span asp-validation-for="PetTypeName"
                      class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">

            <a asp-action="Edit"
               asp-route-id="@Model.PetTypeId"
               class="btn btn-primary">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-success">
                Back to List
            </a>

        </div>

    </div>
</form>
@section Scrripts {
    @{
        await Html.RenderPartialAsync("_vaildationScriptsPartial");
    }
}
