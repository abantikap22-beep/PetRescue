@model IEnumerable<PetRescue.Models.Pet>

@{
    ViewData["Title"] = "Index";
}

<br />
<br />

<div class="row">
    <div class="col-md-6">
        <h2 class="text-info">Pet List</h2>
    </div>

    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn btn-info">
            <i class="fa-solid fa-plus"></i> Add New Pet
        </a>
    </div>
</div>

<br />

<form method="get">
    <div class="row">
        <div class="col-3">
            <input type="text"
                   class="form-control"
                   name="species"
                   placeholder="Search by Pet Type" />
        </div>

        <div class="col-3">
            <input type="submit"
                   value="Search"
                   class="btn btn-success" />
        </div>

        <div class="col-3">
            <a asp-action="Index" class="btn btn-secondary">
                Reset
            </a>
        </div>
    </div>
</form>

<br />

<div>
    <table id="myTable" class="table table-striped table-bordered">

        <thead>
            <tr class="table-info">
                <th>Pet Type</th>
                <th>@Html.DisplayNameFor(c => c.Breed)</th>
                <th>@Html.DisplayNameFor(c => c.Age)</th>
                <th>@Html.DisplayNameFor(c => c.Gender)</th>
                <th>@Html.DisplayNameFor(c => c.Location)</th>
                <th>@Html.DisplayNameFor(c => c.Status)</th>
                <th>Image</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PetType?.PetTypeName</td>
                    <td>@item.Breed</td>
                    <td>@item.Age</td>
                    <td>@item.Gender</td>
                    <td>@item.Location</td>
                    <td>@item.Status</td>

                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@Url.Content("~/" + item.ImageUrl)"
                                 width="70"
                                 height="60"
                                 style="object-fit:cover;" />
                        }
                        else
                        {
                            <img src="~/Images/images.jpg"
                                 width="70"
                                 height="60"
                                 style="object-fit:cover;" />
                        }
                    </td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@item.PetId"
                           class="btn btn-success btn-sm">
                            Edit
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@item.PetId"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.PetId"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>

@section Scripts {

   

    <script src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"></script>


    <script type="text/javascript">
        $(document).ready(function () {
            $('#myTable').DataTable({
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ]
            });
        });
        $(function () {

            var save = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(TempData["save"])
                    );

        if (save) {
            alertify.success(save);
        }

        });

    </script>
}
