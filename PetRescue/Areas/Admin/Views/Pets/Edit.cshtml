@model PetRescue.Models.Pet

@{
    ViewData["Title"] = "Edit Pet";
}

<br />

<h2 class="text-info">Edit Pet</h2>

<form asp-action="Edit"
      asp-controller="Pets"
      asp-area="Admin"
      asp-route-id="@Model.PetId"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PetId" />

    <div class="p-4 rounded border">

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="row">


            <div class="form-group row mb-3">
                <div class="col-md-2">
                    <label asp-for="PetTypeId">Pet Type</label>
                </div>

                <div class="col-md-5">
                    <select asp-for="PetTypeId"
                            asp-items="ViewBag.PetTypeId"
                            class="form-control">
                        <option value=""> Select Pet Type </option>
                    </select>

                    <span asp-validation-for="PetTypeId"
                          class="text-danger"></span>
                </div>
            </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label asp-for="Breed"></label>
                    </div>
                    <div class="col-md-8">
                        <input asp-for="Breed" class="form-control" />
                        <span asp-validation-for="Breed"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label asp-for="Age"></label>
                    </div>
                    <div class="col-md-8">
                        <input asp-for="Age"
                               type="number"
                               class="form-control" />
                        <span asp-validation-for="Age"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label asp-for="Gender"></label>
                    </div>
                    <div class="col-md-8">
                        <select asp-for="Gender" class="form-control">
                            <option value="">-- Select Gender --</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span asp-validation-for="Gender"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label asp-for="Description"></label>
                    </div>
                    <div class="col-md-8">
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="3"></textarea>
                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label asp-for="Location"></label>
                    </div>
                    <div class="col-md-8">
                        <input asp-for="Location"
                               class="form-control" />
                        <span asp-validation-for="Location"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label asp-for="Status"></label>
                    </div>
                    <div class="col-md-8">
                        <select asp-for="Status" class="form-control">
                            <option value="Available">Available</option>
                            <option value="Adopted">Adopted</option>
                            <option value="Pending">Pending</option>
                        </select>
                        <span asp-validation-for="Status"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label>Image</label>
                    </div>
                    <div class="col-md-8">
                        <input type="file"
                               name="image"
                               class="form-control"
                               accept="image/*" />
                    </div>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        Update
                    </button>

                    <a asp-action="Index"
                       asp-controller="Pets"
                       asp-area="Admin"
                       class="btn btn-success">
                        Back to List
                    </a>
                </div>

            </div>

            
            <div class="col-md-4 text-center">

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Url.Content("~/" + Model.ImageUrl)"
                         class="img-fluid"
                         style="max-width:250px; max-height:250px; object-fit:contain;"
                         alt="Pet Image" />
                }
                else
                {
                    <p class="text-muted">No image available</p>
                }

            </div>

        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
