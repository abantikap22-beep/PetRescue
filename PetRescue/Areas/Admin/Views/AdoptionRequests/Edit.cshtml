@model PetRescue.Models.AdoptionRequest

@{
    ViewData["Title"] = "Edit Adoption Request";
}

<br />

<h2 class="text-info">Edit Adoption Request</h2>

<form asp-action="Edit"
      asp-controller="AdoptionRequests"
      asp-area="Admin"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="AdoptionRequestId" />

    <div class="p-4 rounded border">

        <div class="row">
            <div class="col-md-8">

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label>Applicant Name</label>
                    </div>
                    <div class="col-md-8">
                        <input value="@Model.FullName"
                               class="form-control"
                               readonly />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label>Phone Number</label>
                    </div>
                    <div class="col-md-8">
                        <input value="@Model.Phone"
                               class="form-control"
                               readonly />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label>Pet</label>
                    </div>
                    <div class="col-md-8">
                        <input value="@(Model.Pet?.Breed ?? "Not available")"
                               class="form-control"
                               readonly />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label>Address</label>
                    </div>
                    <div class="col-md-8">
                        <textarea class="form-control"
                                  rows="2"
                                  readonly>@Model.Address</textarea>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label>Reason for Adoption</label>
                    </div>
                    <div class="col-md-8">
                        <textarea class="form-control"
                                  rows="3"
                                  readonly>@Model.Reason</textarea>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label>Pet Experience</label>
                    </div>
                    <div class="col-md-8">
                        <input value="@(Model.HasPetExperience ? "Yes" : "No")"
                               class="form-control"
                               readonly />
                    </div>
                </div>

                <<div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label>Status</label>
                    </div>
                    <div class="col-md-8">
                        <select asp-for="Status" class="form-control">
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        Update
                    </button>

                    <a asp-action="Index"
                       asp-controller="AdoptionRequests"
                       asp-area="Admin"
                       class="btn btn-success">
                        Back to List
                    </a>
                </div>

            </div>
        </div>
    </div>
</form>