@model PetRescue.Models.AdoptionRequest

@{
    ViewData["Title"] = "Reject";
}

<br />

<h2 class="text-info">Reject Adoption Request</h2>

<div class="p-4 rounded border">

    <div class="row">

        <div class="col-md-8">

            <div class="form-group row mb-3">
                <div class="col-md-2">
                    <label>Request ID</label>
                </div>
                <div class="col-md-8">
                    <input value="@Model.AdoptionRequestId"
                           readonly class="form-control" />
                </div>
            </div>

            <div class="form-group row mb-3">
                <div class="col-md-2">
                    <label>Applicant Name</label>
                </div>
                <div class="col-md-8">
                    <input value="@Model.FullName"
                           readonly class="form-control" />
                </div>
            </div>

            <div class="form-group row mb-3">
                <div class="col-md-2">
                    <label>Email</label>
                </div>
                <div class="col-md-8">
                    <input value="@Model.Email"
                           readonly class="form-control" />
                </div>
            </div>

            <div class="form-group row mb-3">
                <div class="col-md-2">
                    <label>Phone</label>
                </div>
                <div class="col-md-8">
                    <input value="@Model.Phone"
                           readonly class="form-control" />
                </div>
            </div>

            <div class="form-group row mb-3">
                <div class="col-md-2">
                    <label>Pet ID</label>
                </div>
                <div class="col-md-8">
                    <input value="@(Model.Pet?.PetId.ToString() ?? "Not available")"
                           readonly class="form-control" />
                </div>
            </div>

            <div class="form-group row mb-3">
                <div class="col-md-2">
                    <label>Pet Breed</label>
                </div>
                <div class="col-md-8">
                    <input value="@(Model.Pet?.Breed ?? "Not available")"
                           readonly class="form-control" />
                </div>
            </div>

            <div class="form-group row mb-3">
                <div class="col-md-2">
                    <label>Address</label>
                </div>
                <div class="col-md-8">
                    <textarea readonly class="form-control"
                              rows="2">@Model.Address</textarea>
                </div>
            </div>

            <div class="form-group row mb-3">
                <div class="col-md-2">
                    <label>Reason</label>
                </div>
                <div class="col-md-8">
                    <textarea readonly class="form-control"
                              rows="3">@Model.Reason</textarea>
                </div>
            </div>

            <div class="form-group row mb-3">
                <div class="col-md-2">
                    <label>Pet Experience</label>
                </div>
                <div class="col-md-8">
                    <input value="@(Model.HasPetExperience ? "Yes" : "No")"
                           readonly class="form-control" />
                </div>
            </div>

            <div class="form-group row mb-3">
                <div class="col-md-2">
                    <label>Status</label>
                </div>
                <div class="col-md-8">
                    <input value="@Model.Status"
                           readonly class="form-control" />
                </div>
            </div>

            <div class="form-group row mb-3">
                <div class="col-md-2">
                    <label>Request Date</label>
                </div>
                <div class="col-md-8">
                    <input value="@Model.RequestDate.ToString("dd MMM yyyy, hh:mm tt")"
                           readonly class="form-control" />
                </div>
            </div>

            <div class="form-group">

                <form asp-action="Reject"
                      asp-controller="AdoptionRequests"
                      asp-area="Admin"
                      asp-route-id="@Model.AdoptionRequestId"
                      method="post"
                      class="d-inline"
                      onsubmit="return confirm('Are you sure you want to reject this request?');">

                    <button type="submit" class="btn btn-danger">
                        Confirm Reject
                    </button>

                </form>

                <a asp-action="Index"
                   asp-controller="AdoptionRequests"
                   asp-area="Admin"
                   class="btn btn-success">
                    Back to List
                </a>

            </div>

        </div>

    </div>

</div>
