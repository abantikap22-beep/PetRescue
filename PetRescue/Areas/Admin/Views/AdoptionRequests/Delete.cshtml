@model PetRescue.Models.AdoptionRequest

@{
    ViewData["Title"] = "Delete Adoption Request";
}

<br />

<h2 class="text-info">Adoption Request Delete</h2>

<form asp-action="Delete"
      asp-controller="AdoptionRequests"
      asp-area="Admin"
      asp-route-id="@Model.AdoptionRequestId"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="AdoptionRequestId" />

    <div class="p-4 rounded border">

        <div class="row">

            <div class="col-md-8">

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label>Request ID</label>
                    </div>
                    <div class="col-md-8">
                        <input value="@Model.AdoptionRequestId"
                               readonly class="form-control" />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label>Applicant Name</label>
                    </div>
                    <div class="col-md-8">
                        <input value="@Model.FullName"
                               readonly class="form-control" />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label>Email</label>
                    </div>
                    <div class="col-md-8">
                        <input value="@Model.User?.Email"
                               readonly class="form-control" />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label>Phone Number</label>
                    </div>
                    <div class="col-md-8">
                        <input value="@Model.Phone"
                               readonly class="form-control" />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label>Pet</label>
                    </div>
                    <div class="col-md-8">
                        <input value="@(Model.Pet?.Breed ?? "Not available")"
                               readonly class="form-control" />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label>Address</label>
                    </div>
                    <div class="col-md-8">
                        <textarea readonly
                                  class="form-control"
                                  rows="2">@Model.Address</textarea>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label>Reason</label>
                    </div>
                    <div class="col-md-8">
                        <textarea readonly
                                  class="form-control"
                                  rows="3">@Model.Reason</textarea>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label>Pet Experience</label>
                    </div>
                    <div class="col-md-8">
                        <input value="@(Model.HasPetExperience ? "Yes" : "No")"
                               readonly class="form-control" />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label>Status</label>
                    </div>
                    <div class="col-md-8">
                        <input value="@Model.Status"
                               readonly class="form-control" />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-2">
                        <label>Request Date</label>
                    </div>
                    <div class="col-md-8">
                        <input value="@Model.RequestDate.ToString("dd MMM yyyy, hh:mm tt")"
                               readonly class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <h4>Do you want to delete this adoption request?</h4>

                    <button type="submit" class="btn btn-danger">
                        Delete
                    </button>

                    <a asp-action="Index"
                       asp-controller="AdoptionRequests"
                       asp-area="Admin"
                       class="btn btn-success">
                        Back to List
                    </a>
                </div>

            </div>

        </div>
    </div>
</form>