@model IEnumerable<PetRescue.Models.AdoptionRequest>

@{
    ViewData["Title"] = "Adoption Requests";
}

<br />
<br />

<div class="row">
    <div class="col-md-6">
        <h2 class="text-info">Adoption Requests List</h2>
    </div>
</div>

<br />

<div>
    <table id="myTable" class="table table-striped table-bordered">

        <thead>
            <tr class="table-info">
                <th>Request ID</th>
                <th>Applicant Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Pet</th>
                <th>Address</th>
                <th>Reason</th>
                <th>Pet Experience</th>
                <th>Status</th>
                <th>Request Date</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.AdoptionRequestId</td>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>

                    <td>
                        @if (item.Pet != null)
                        {
                            <span>
                              Pet ID: @item.Pet.PetId
                         
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">Pet not found</span>
                        }
                    </td>

                    <td>@item.Address</td>

                    <td>
                        @if (!string.IsNullOrEmpty(item.Reason))
                        {
                            @item.Reason
                        }
                        else
                        {
                            <span class="text-muted">Not provided</span>
                        }
                    </td>

                    <td>
                        @if (item.HasPetExperience)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>

                    <td>
                        @if (item.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">
                                @item.Status
                            </span>
                        }
                        else if (item.Status == "Approved")
                        {
                            <span class="badge bg-success">
                                @item.Status
                            </span>
                        }
                        else if (item.Status == "Rejected")
                        {
                            <span class="badge bg-danger">
                                @item.Status
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">
                                @item.Status
                            </span>
                        }
                    </td>

                    <td>
                        @item.RequestDate.ToString("dd-MM-yyyy")
                    </td>

                    <td style="white-space:nowrap;">

                        <a asp-action="Details"
                           asp-controller="AdoptionRequests"
                           asp-area="Admin"
                           asp-route-id="@item.AdoptionRequestId"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        @if (item.Status == "Pending")
                        {
                            <form asp-action="Approve"
                                  asp-controller="AdoptionRequests"
                                  asp-area="Admin"
                                  asp-route-id="@item.AdoptionRequestId"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Approve this request? The pet will be marked as adopted and other pending requests for it will be rejected.');">

                                <button type="submit" class="btn btn-success btn-sm">
                                    Approve
                                </button>
                            </form>

                            <form asp-action="Reject"
                                  asp-controller="AdoptionRequests"
                                  asp-area="Admin"
                                  asp-route-id="@item.AdoptionRequestId"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Reject this request?');">

                                <button type="submit" class="btn btn-warning btn-sm">
                                    Reject
                                </button>
                            </form>
                        }

                        <a asp-action="Delete"
                           asp-controller="AdoptionRequests"
                           asp-area="Admin"
                           asp-route-id="@item.AdoptionRequestId"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>

@section Scripts {

    <script src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#myTable').DataTable({
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ]
            });

            var save = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(TempData["save"])
                    );

        var error = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(TempData["error"])
                );

        if (save) {
            alertify.success(save);
        }

            if (error) {
                alertify.error(error);
            }
        });
    </script>
}
