@using PetRescue.Models
@model List<Pet>

@{
    ViewData["Title"] = "Cart";
}

<h1>Your Pet Cart</h1>

<br />

@if (Model != null && Model.Any())
{
    <form asp-area="Customer"
          asp-controller="Adoption"
          asp-action="Checkout"
          method="get">

        <div class="row">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Select</th>
                        <th>Image</th>
                        <th>Breed</th>
                        <th>Pet Type</th>
                        <th>Age</th>
                        <th>Gender</th>
                        <th>Location</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <input type="checkbox"
                                       name="id"
                                       value="@item.PetId"
                                       class="pet-checkbox" />
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@Url.Content("~/" + item.ImageUrl)"
                                         width="120"
                                         height="100"
                                         style="object-fit:contain;" />
                                }
                            </td>

                            <td>@item.Breed</td>
                            <td>@item.PetType?.PetTypeName</td>
                            <td>@item.Age</td>
                            <td>@item.Gender</td>
                            <td>@item.Location</td>

                            <td>
                                <a asp-action="Remove"
                                   asp-controller="Home"
                                   asp-area="Customer"
                                   asp-route-id="@item.PetId"
                                   class="btn btn-danger">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row">
            <div class="col-6">
                <a asp-action="Index"
                   asp-controller="Home"
                   asp-area="Customer"
                   class="btn btn-success">
                    Continue Browsing
                </a>
            </div>

            <div class="col-6 text-end">
                <h3>Total Pets: @Model.Count</h3>

                <button type="submit" class="btn btn-primary">
                    Continue For Adoption
                </button>
            </div>
        </div>

    </form>
}
else
{
    <div class="alert alert-info">
        Your cart is empty. Please add a pet first.
    </div>

    <a asp-action="Index"
       asp-controller="Home"
       asp-area="Customer"
       class="btn btn-success">
        Browse Pets
    </a>
}

@section Scripts {
    <script>
        document.querySelectorAll('.pet-checkbox').forEach(function (checkbox) {

            checkbox.addEventListener('change', function () {

                var selected = document.querySelectorAll(
                    '.pet-checkbox:checked'
                );

                if (selected.length > 1) {
                    this.checked = false;

                    alert('Please select only one pet at a time.');
                }
            });

        });
    </script>
}
