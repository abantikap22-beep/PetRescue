@model PetRescue.Models.Pet

@{
    ViewData["Title"] = "Details";
}
@using PetRescue.utility
@using Microsoft.AspNetCore.Http

@inject IHttpContextAccessor HttpContextAccessor

@{
    List<int> pets = HttpContextAccessor.HttpContext.Session
        .Get<List<int>>("pets") ?? new List<int>();

    bool isInAdoptionList = pets.Contains(Model.PetId);
}

<br />

<h2 class="text-info">Pet Details</h2>

<form asp-action="Detail"
      asp-controller="Home"
      asp-area="Customer"
      method="post">

    <input type="hidden" name="id" value="@Model.PetId" />

    <div class="p-4 rounded border">
        <div class="row">

            <div class="col-md-8">

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label>Pet Type</label>
                    </div>
                    <div class="col-md-7">
                        <input value="@Model.PetType?.PetTypeName"
                               readonly="readonly"
                               class="form-control" />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label asp-for="Breed"></label>
                    </div>
                    <div class="col-md-7">
                        <input asp-for="Breed"
                               readonly="readonly"
                               class="form-control" />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label asp-for="Age"></label>
                    </div>
                    <div class="col-md-7">
                        <input asp-for="Age"
                               readonly="readonly"
                               class="form-control" />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label asp-for="Gender"></label>
                    </div>
                    <div class="col-md-7">
                        <input asp-for="Gender"
                               readonly="readonly"
                               class="form-control" />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label asp-for="Description"></label>
                    </div>
                    <div class="col-md-7">
                        <textarea asp-for="Description"
                                  readonly="readonly"
                                  class="form-control"
                                  rows="3"></textarea>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label asp-for="Location"></label>
                    </div>
                    <div class="col-md-7">
                        <input asp-for="Location"
                               readonly="readonly"
                               class="form-control" />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        <label asp-for="Status"></label>
                    </div>
                    <div class="col-md-7">
                        <input asp-for="Status"
                               readonly="readonly"
                               class="form-control" />
                    </div>
                </div>

                <div class="mt-4">
                    <a asp-action="Index"
                       asp-controller="Home"
                       asp-area="Customer"
                       class="btn btn-success">
                        Back to List
                    </a>
                </div>

            </div>

            <div class="col-md-4 text-center">

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Url.Content("~/" + Model.ImageUrl)"
                         class="img-fluid rounded"
                         style="width:100%; max-width:280px; height:280px; object-fit:contain;"
                         alt="Pet Image" />
                }
                else
                {
                    <img src="~/Images/images.jpg"
                         class="img-fluid rounded"
                         style="width:100%; max-width:280px; height:280px; object-fit:contain;"
                         alt="Default Pet Image" />
                }

                <div class="mt-3">

                    @if (isInAdoptionList)
                    {
                        <a asp-action="Remove"
                           asp-controller="Home"
                           asp-area="Customer"
                           asp-route-id="@Model.PetId"
                           class="btn btn-secondary">
                            Remove
                        </a>
                    }
                    else
                    {
                        <a asp-area="Customer"
                           asp-controller="Adoption"
                           asp-action="Checkout"
                           asp-route-id="@Model.PetId"
                           class="btn btn-primary">
                            Adopt
                        </a>
                    }

                </div>

            </div>

        </div>
    </div>
</form>
