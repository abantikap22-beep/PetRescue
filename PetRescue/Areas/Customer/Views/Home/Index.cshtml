@using PetRescue.Models
@model List<Pet>


@{
    ViewData["Title"] = "Home Page";
}

<br />
<br />

<h2 class="text-info text-center">Available for Adoption</h2>

<br />

<div class="row">

    @foreach (var pet in Model)
    {
        <div class="col-4">

            <div class="card mb-4 h-100">

                <div class="card-header text-center">
                    <h4 class="my-0 font-weight-normal">
                        <label style="font-size: 23px; color: steelblue">
                            @pet.Breed
                        </label>
                    </h4>
                </div>

                <img src="~/@pet.ImageUrl"
                     alt="Pet Image"
                     class="card-img-top"
                     style="height:300px; object-fit:contain;" />

                <div class="card-footer">
                    <div class="d-flex justify-content-between align-items-center">

                        <a asp-action="Detail"
                           asp-controller="Home"
                           asp-area="Customer"
                           asp-route-id="@pet.PetId"
                           class="btn btn-success">
                            Details
                        </a>

                        <form asp-action="Detail"
                              asp-controller="Home"
                              asp-area="Customer"
                              method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@pet.PetId" />

                            <button type="submit"
                                    class="btn btn-success btn-outline-info">
                                Adopt
                            </button>

                        </form>

                    </div>
                </div>

            </div>

        </div>
    }

</div>
